{
  "name": "indidraw",
  "version": "0.2.0",
  "description": "A free, local-first whiteboard for diagrams, sketches and flowcharts in English and five Indian languages, built on Excalidraw.",
  "keywords": [
    "whiteboard",
    "diagram",
    "excalidraw",
    "offline",
    "pwa",
    "hindi",
    "telugu",
    "bengali",
    "tamil",
    "marathi",
    "malayalam",
    "indic",
    "transliteration"
  ],
  "homepage": "https://github.com/ravi4chan/indidraw#readme",
  "bugs": {
    "url": "https://github.com/ravi4chan/indidraw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravi4chan/indidraw.git"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/assets.mjs && vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/assets.mjs && vite build && node scripts/service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.js *.json *.md docs/*.md"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "@indic-transliteration/sanscript": "1.3.3",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
